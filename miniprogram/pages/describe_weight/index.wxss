/* pages/describe_weight/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4f6f8 0%, #f7f8fa 34%, #ffffff 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.headerCard {
  border-radius: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #33c875 0%, #1bb86b 50%, #79dfa7 100%);
  box-shadow: 0 14rpx 34rpx rgba(27, 184, 107, 0.2);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.headerSeed {
  position: absolute;
  top: 16rpx;
  font-size: 34rpx;
  opacity: 0.9;
  animation: headerSeedFloat 2.6s ease-in-out infinite;
}

.headerSeedLeft {
  left: 18rpx;
}

.headerSeedRight {
  right: 18rpx;
  animation-delay: 0.8s;
}

.headerTitle {
  color: #fffdf8;
  display: inline-block;
  width: 100%;
  font-size: 44rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 0;
  font-family: "YouYuan", "幼圆", "Arial Rounded MT Bold", "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  text-shadow: 0 3rpx 0 rgba(93, 157, 116, 0.34), 0 9rpx 16rpx rgba(121, 187, 144, 0.26);
  -webkit-text-stroke: 1rpx rgba(255, 255, 255, 0.68);
  animation: titlePop 2.2s ease-in-out infinite;
}

.headerSub {
  margin-top: 8rpx;
  color: rgba(255, 254, 250, 0.95);
  font-size: 24rpx;
  text-align: center;
}

.tipsCard,
.statusCard,
.weightCard {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(165deg, #ffffff 0%, #f9fbfd 100%);
  border: 1px solid #edf0f3;
  box-shadow: 0 10rpx 28rpx rgba(15, 41, 77, 0.06);
  padding: 28rpx 24rpx;
}

.cardAnimated {
  animation: cardRiseIn 0.55s ease both;
}

.statusCardActive {
  border-color: rgba(35, 186, 114, 0.34);
  box-shadow: 0 14rpx 30rpx rgba(35, 186, 114, 0.14);
}

.weightCardSuccess {
  animation: successPulse 1.2s ease;
}

.tipsTitle {
  font-size: 30rpx;
  font-weight: 900;
  color: #1f2329;
}

.tipsText {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7d8792;
}

.statusRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.statusLabel {
  font-size: 26rpx;
  color: #5f6b7a;
}

.statusValue {
  position: relative;
  font-size: 24rpx;
  font-weight: 700;
  color: #13a35f;
  background: rgba(19, 163, 95, 0.12);
  border-radius: 999rpx;
  padding: 8rpx 18rpx 8rpx 34rpx;
}

.statusValue::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: #13a35f;
}

.statusValue.linking {
  color: #f28c12;
  background: rgba(242, 140, 18, 0.16);
  animation: linkingGlow 1s ease-in-out infinite;
}

.statusValue.linking::before {
  background: #f28c12;
}

.statusValue.disconnected {
  color: #e05252;
  background: rgba(224, 82, 82, 0.12);
}

.statusValue.disconnected::before {
  background: #e05252;
}

.statusHint {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6f7a88;
}

.weightTop {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weightTitle {
  font-size: 30rpx;
  font-weight: 900;
  color: #1f2329;
}

.fetchBtn {
  margin: 0;
  padding: 0 30rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  border: none;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #23ba72 0%, #16a764 100%);
  box-shadow: 0 8rpx 20rpx rgba(22, 167, 100, 0.28);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fetchBtnLoading {
  opacity: 0.92;
  transform: scale(0.97);
}

.weightNumberWrap {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 10rpx;
}

.weightNumber {
  font-size: 88rpx;
  line-height: 1;
  color: #9aa3ad;
  font-weight: 900;
  letter-spacing: 2rpx;
  transition: all 0.25s ease;
}

.weightNumberActive {
  color: #1f2329;
  transform: translateY(-2rpx) scale(1.02);
  text-shadow: 0 7rpx 14rpx rgba(31, 35, 41, 0.12);
}

.weightNumberJitter {
  animation: numberJitter 0.22s linear infinite;
}

.weightUnit {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #4b5868;
}

.weightTime {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8a95a3;
  text-align: center;
}

.weightSample {
  margin-top: 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #5f6b7a;
  text-align: center;
}

@keyframes cardRiseIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes linkingGlow {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(242, 140, 18, 0.32);
  }
  50% {
    box-shadow: 0 0 0 10rpx rgba(242, 140, 18, 0);
  }
}

@keyframes successPulse {
  0% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.012);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes numberJitter {
  0% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-0.8rpx);
  }
  50% {
    transform: translateX(0.8rpx);
  }
  75% {
    transform: translateX(-0.5rpx);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes titlePop {
  0%,
  100% {
    transform: translateY(0) scale(1) scaleY(0.88);
  }
  50% {
    transform: translateY(-2rpx) scale(1.04) scaleY(0.88);
  }
}

@keyframes headerSeedFloat {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-5rpx) rotate(-8deg);
  }
}

/* 采样按钮倒计时态 */
.fetchBtnSampling {
  background: linear-gradient(135deg, #f28c12 0%, #e07a00 100%) !important;
  box-shadow: 0 8rpx 20rpx rgba(242, 140, 18, 0.35) !important;
}

/* 采样进度动画条 */
@keyframes samplingBounce {
  0%, 80%, 100% { transform: scaleY(0.5); opacity: 0.4; }
  40%           { transform: scaleY(1.2); opacity: 1; }
}
.samplingBar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 18rpx 0 4rpx;
}
.samplingDot {
  width: 10rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: #23ba72;
  animation: samplingBounce 1s ease-in-out infinite;
}
.samplingDot2 { animation-delay: 0.15s; }
.samplingDot3 { animation-delay: 0.30s; }
.samplingText {
  font-size: 22rpx;
  color: #23ba72;
  margin-left: 10rpx;
  font-weight: 600;
}

/* 确认保存按钮 */
@keyframes confirmBtnIn {
  from { opacity: 0; transform: translateY(12rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.confirmBtn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #23ba72 0%, #16a764 100%);
  border-radius: 52rpx;
  padding: 22rpx 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(22, 167, 100, 0.38);
  animation: confirmBtnIn 0.3s cubic-bezier(0.34, 1.4, 0.64, 1) both;
  transition: transform 0.14s ease;
}
.confirmBtn:active { transform: scale(0.96); }
.confirmBtnText {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* 历史记录卡片 */
.historyCard {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(165deg, #ffffff 0%, #f9fbfd 100%);
  border: 1px solid #edf0f3;
  box-shadow: 0 10rpx 28rpx rgba(15, 41, 77, 0.06);
  padding: 24rpx;
  overflow: hidden;
}
.historyHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.historyTitle {
  font-size: 30rpx;
  font-weight: 900;
  color: #1f2329;
}
.historyCount {
  font-size: 24rpx;
  color: #9aa3ad;
}
.historySelectActions {
  display: flex;
  gap: 28rpx;
}
.historySelectCancel {
  font-size: 26rpx;
  color: #6f7a88;
}
.historySelectAll {
  font-size: 26rpx;
  color: #23ba72;
  font-weight: 700;
}

/* 历史条目 */
.historyItem {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f6;
  gap: 16rpx;
  transition: background 0.15s;
}
.historyItem:last-child { border-bottom: none; }
.historyItemSelected { background: #f0f7ff; border-radius: 16rpx; padding-left: 12rpx; }
.historyItemLeft {
  flex: 1;
}
.historyValue {
  font-size: 40rpx;
  font-weight: 900;
  color: #1f2329;
  line-height: 1.1;
}
.historyUnit {
  font-size: 22rpx;
  font-weight: 600;
  color: #5f6b7a;
}
.historyDevice {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa3ad;
}
.historyItemRight {
  text-align: right;
  flex-shrink: 0;
}
.historyTime {
  font-size: 22rpx;
  color: #7d8792;
}
.historySampleCount {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #b0b8c2;
}

/* 勾选框 */
.historyCheckbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #c8cdd4;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: #fff;
}
.historyCheckboxChecked {
  background: #4A90E2;
  border-color: #4A90E2;
}
.checkIcon {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

/* 批量删除栏 */
@keyframes deleteBarIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.historyDeleteBar {
  margin-top: 20rpx;
  animation: deleteBarIn 0.25s cubic-bezier(0.34, 1.4, 0.64, 1) both;
}
.historyDeleteBtn {
  background: linear-gradient(135deg, #FF7E7E 0%, #FF3F3F 100%);
  border-radius: 48rpx;
  padding: 20rpx 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 63, 63, 0.38);
  transition: transform 0.14s ease;
}
.historyDeleteBtn:active { transform: scale(0.96); }
.historyDeleteBtnDisabled {
  background: linear-gradient(135deg, #CDD0D8, #B8BCC6) !important;
  box-shadow: none !important;
}
.historyDeleteText {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
